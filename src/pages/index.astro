---
// src/pages/index.astro
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Windows 95 App</title>
  <link rel="stylesheet" href="styles/global.css">
</head>
<body>

  <!-- The Windows 95 Window Container -->
  <div class="win-window">
    <!-- Title Bar -->
    <div class="win-titlebar">
      <span>Document.txt - Notepad</span>
      <div class="win-titlebar-controls">
        <button class="win-btn">?</button>
        <button class="win-btn">X</button>
      </div>
    </div>
    
    <!-- Content Area -->
    <div class="win-content">
      <p>Welcome to 1995. Type something below:</p>
      <p>
        <input type="text" class="win-input" value="Hello, World!" />
      </p>
      <p>
        <button class="win-btn">OK</button>
        <button class="win-btn">Cancel</button>
      </p>
    </div>
  </div>

</body>
</html>

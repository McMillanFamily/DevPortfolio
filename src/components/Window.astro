---
// src/components/Window.astro
interface Props {
  title: string;
  width?: string;
  id?: string;
}

const { title, width = '100%', id } = Astro.props;
---

<div class="win-window" style={`width: ${width};`} id={id}>
  <div class="win-titlebar">
    <span>{title}</span>
    <div class="win-titlebar-controls">
      <button class="win-btn" type="button" aria-label="Minimise">_</button>
      <button class="win-btn" type="button" aria-label="Maximise">□</button>
      <button class="win-btn" type="button" aria-label="Close">×</button>
    </div>
  </div>
  <div class="win-content">
    <slot />
  </div>
</div>
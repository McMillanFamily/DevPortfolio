---
// src/components/InfoPanel.astro
import Window from "./Window.astro";
import type { Entry } from "../data/experience";
import { config } from "astro:schema";

interface Props{
    title: string;
    id: string
    entries: Entry[]
    width?: string
}

const {title, id, entries, width = '100%' } = Astro.props
---

<Window title={title} width={width} id={id}>
  <div class="info-panel edge-sunken">
    {entries.map((entry) => (
      <div class="info-item">
        <div class="info-title">📄 {entry.title}</div>
        <div class="info-org">{entry.org}</div>
        <div class="info-period">{entry.period}</div>
        {entry.details && entry.details.length > 0 && (
          <ul class="info-details">
            {entry.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</Window>
